# SOBASED environment. Copy to .env and fill in. Never commit .env.
# Lines marked [prod] only matter on the server.

# --- Django ---------------------------------------------------------------
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# true in development only. false in production (config.settings.prod
# forces it off anyway).
DJANGO_DEBUG=true
# Comma-separated hostnames Django answers to. [prod] your domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Public URL of the site, no trailing slash. Used in e-mail links, CSRF and
# cookie security (cookies are Secure when this starts with https://).
SITE_URL=http://localhost:8080

# --- Caddy [prod] ---------------------------------------------------------
# Domain served by Caddy (DNS A/AAAA record pointing at the VPS) and the
# e-mail Let's Encrypt writes to about certificates.
DOMAIN=
ACME_EMAIL=

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=sobased
POSTGRES_USER=sobased
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres

# --- Redis (cache, sessions, Celery). No database suffix. ------------------
REDIS_URL=redis://redis:6379

# --- Encryption of OAuth tokens and share-link tokens ----------------------
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this key makes stored OAuth tokens and share URLs unreadable.
FERNET_KEY=change-me

# --- Accounts -------------------------------------------------------------
# true: anyone can sign up. false: sign-up only through an invitation link.
REGISTRATION_OPEN=true

# --- E-mail (SMTP). Empty EMAIL_HOST = e-mails are printed in the backend
# and worker logs instead of being sent (development). ----------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SOBASED <no-reply@example.org>

# --- Files ----------------------------------------------------------------
# Maximum size of one uploaded file, in megabytes.
MAX_UPLOAD_MB=500
# true: Caddy streams protected files itself (X-Accel-Redirect), which both
# stacks do. false only without such a proxy (Django then streams them).
PROTECTED_MEDIA_ACCEL=true
# local (default): files on the media volume, streamed by Caddy after Django
# checked the rights. s3: a private S3-compatible bucket (Infomaniak Object
# Storage), reached through pre-signed URLs valid SIGNED_URL_SECONDS.
STORAGE_BACKEND=local
SIGNED_URL_SECONDS=60
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Share links ------------------------------------------------------------
# Sound tag mixed into shared audio every N seconds when the watermark is on
# (path inside the container, WAV or MP3). Empty = a discreet generated beep.
AUDIO_WATERMARK_TAG=
AUDIO_WATERMARK_INTERVAL_S=30

# --- Google (Drive + Picker; Calendar from phase 11) ------------------------
# Google Cloud project: OAuth client (Web application) with the redirect URI
# <SITE_URL>/api/integrations/google/callback/, Drive API + Picker API enabled,
# an API key restricted to the Picker, the project number as app id.
# Empty client id or secret = integration disabled (buttons hidden).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# --- Microsoft Graph (phase 11) ---------------------------------------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Backups [prod] (scripts/backup.sh, docs/deploy.md) -----------------------
# Passphrase encrypting every archive (AES-256). Keep a copy OUTSIDE the
# server: without it a backup is unreadable.
BACKUP_PASSPHRASE=
# Where archives are written on the server (30 days kept).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# Optional rclone remote for the off-site copy, e.g. "swissbackup:sobased"
# (Infomaniak Swiss Backup, S3 or SFTP: see docs/deploy.md). Empty = local only.
BACKUP_REMOTE=
